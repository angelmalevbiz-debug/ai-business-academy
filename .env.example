# Optional: absolute SQLite file path on a persistent disk. Default: .data/community.db
# COMMUNITY_DB_PATH=C:/data/community.db
# Set an exact HTTPS origin behind a production reverse proxy.
# APP_ORIGIN=https://your-domain.example

# Use only for npm run admin:create. Never commit real values.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=

# Workflow uses an installed local Ollama model by default. No model is downloaded.
# WORKFLOW_AI_PROVIDER=ollama
# WORKFLOW_AI_MODEL=qwen3:8b
# Optional explicit specialist for written-copy tasks only (same provider).
# No fallback or download: the selected model must already be available.
# The local audit passed with this model; 8b leaked editing instructions.
# WORKFLOW_AI_COPY_MODEL=qwen3:14b
# Optional stronger, already installed local model for product positioning.
# WORKFLOW_POSITIONING_MODEL=qwen3:14b
# WORKFLOW_OLLAMA_ORIGIN=http://127.0.0.1:11434
# Optional server-only alternative. Model must be explicitly configured.
# WORKFLOW_AI_PROVIDER=openai
# WORKFLOW_AI_MODEL=
# OPENAI_API_KEY=
# Optional operator-only read/import bridge to the existing local publisher.
# WORKFLOW_PUBLISHER_ORIGIN=http://127.0.0.1:8881

# Website generation/refinement uses your own Ollama weights, separately from Workflow.
# No paid provider fallback. The built-in designer needs no model at all.
# WEBSITE_AI_PROVIDER=ollama
# Set 'none' to disable model requests; the visual designer still works.
# WEBSITE_AI_MODEL=qwen3:14b
# Optional explicit self-hosted server on another VPS or device (server-side only).
# Default: loopback WORKFLOW_OLLAMA_ORIGIN or http://127.0.0.1:11434.
# WEBSITE_OLLAMA_ORIGIN=https://ai.your-domain.example
# WEBSITE_OLLAMA_TOKEN=your_reverse_proxy_bearer_token
# Private HTTP is opt-in, RFC1918/IPv6 addresses only; prefer authenticated HTTPS.
# WEBSITE_OLLAMA_ALLOW_PRIVATE_HTTP=true
# On the model host set OLLAMA_NO_CLOUD=1 to disable Ollama cloud routing.
# Licensed Wikimedia Commons image search requires internet, no API key or fee.
# Set 'none' to disable remote photo search; upload your own images instead.
# WEBSITE_IMAGE_SEARCH=commons
# Per-member website provider connections. Configure provider applications first.
# Never commit actual secrets. The encryption key is exactly 64 random hex characters.
# SITE_CONNECTION_ENCRYPTION_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# VERCEL_INTEGRATION_CLIENT_ID=
# VERCEL_INTEGRATION_CLIENT_SECRET=
# VERCEL_INTEGRATION_SLUG=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Callback: {APP_ORIGIN}/api/connections/{google|vercel|github}/callback
# A Google login does not create accounts on GitHub or Vercel.
# Vercel business hosting is subject to the account's provider plan.

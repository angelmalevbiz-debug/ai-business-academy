# Copy this file to .env in the repository root on your VPS. Never commit .env.
# Use the precise public origin, HTTPS, and no trailing slash.
APP_ORIGIN=https://academy.example.com

# The built-in website designer and visual editor need no AI model or paid API.
WEBSITE_AI_PROVIDER=none
WEBSITE_IMAGE_SEARCH=commons

# Optional own Ollama model for website generation/editing. No paid fallback.
# WEBSITE_AI_PROVIDER=ollama
# WEBSITE_AI_MODEL=qwen3:14b
# WEBSITE_OLLAMA_ORIGIN=https://ai.example.com
# WEBSITE_OLLAMA_TOKEN=
# WEBSITE_OLLAMA_ALLOW_PRIVATE_HTTP=false

# Workflow text agents require an installed model. They are not simulated when
# a model is absent. The optional worker is enabled separately in Compose.
WORKFLOW_AI_PROVIDER=ollama
# WORKFLOW_AI_MODEL=qwen3:14b
# WORKFLOW_AI_COPY_MODEL=qwen3:14b
# WORKFLOW_POSITIONING_MODEL=qwen3:14b
# WORKFLOW_OLLAMA_ORIGIN=http://127.0.0.1:11434

# Optional per-member Google/GitHub/Vercel connections. Register applications
# with each provider and configure their callback URLs before enabling them.
# Generate the encryption key once: openssl rand -hex 32
# Preserve this key through updates and backups. Do not rotate it casually.
# SITE_CONNECTION_ENCRYPTION_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# VERCEL_INTEGRATION_CLIENT_ID=
# VERCEL_INTEGRATION_CLIENT_SECRET=
# VERCEL_INTEGRATION_SLUG=

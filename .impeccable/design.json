    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A clear, solid action in the operating shell.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Създай задача</button>",
      "css": ".ds-button-primary{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);min-height:46px;padding:12px 17px;border:1px solid transparent;border-radius:9px;background:#cf352c;color:#fff;font-size:13px;cursor:pointer;box-shadow:none}.ds-button-primary:hover:not(:disabled){background:#b62d25}.ds-button-primary:focus-visible{outline:3px solid #7aa9e8;outline-offset:4px;}.ds-button-primary:disabled{opacity:.5;cursor:wait}@media(prefers-reduced-motion:no-preference){.ds-button-primary{transition:background-color 160ms ease,color 160ms ease,transform 120ms ease-out}}@media(prefers-reduced-motion:no-preference){.ds-button-primary:active:not(:disabled){transform:scale(.975)}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",

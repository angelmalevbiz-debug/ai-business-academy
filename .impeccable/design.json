  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A clear, solid action in the operating shell.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Създай задача</button>",
      "css": ".ds-button-primary{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);min-height:46px;padding:12px 17px;border:1px solid transparent;border-radius:9px;background:#cf352c;color:#fff;font-size:13px;cursor:pointer;box-shadow:none}.ds-button-primary:hover:not(:disabled){background:#b62d25}.ds-button-primary:focus-visible{outline:3px solid #7aa9e8;outline-offset:4px;}.ds-button-primary:disabled{opacity:.5;cursor:wait}@media(prefers-reduced-motion:no-preference){.ds-button-primary{transition:background-color 160ms ease,color 160ms ease}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A supporting shell control with a visible boundary.",
      "html": "<button class=\"ds-button-secondary\" type=\"button\">Назад</button>",
      "css": ".ds-button-secondary{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);min-height:46px;padding:12px 17px;border:1px solid #525865;border-radius:9px;background:#252931;color:#f0f2f6;font-size:13px;cursor:pointer;box-shadow:none}.ds-button-secondary:hover{background:#252931;color:#f0f2f6}.ds-button-secondary:focus-visible{outline:3px solid #7aa9e8;outline-offset:4px;}.ds-button-secondary:disabled{opacity:.5;cursor:wait}@media(prefers-reduced-motion:no-preference){.ds-button-secondary{transition:background-color 160ms ease,color 160ms ease}}"
    },
    {
      "name": "Task Field",
      "kind": "input",
      "refersTo": "task-field",
      "description": "A labeled writable field on the current task's paper.",
      "html": "<label class=\"ds-field-label\">Какво искаш да създадеш?<textarea class=\"ds-task-field\" rows=\"3\" placeholder=\"Опиши целта и за кого е резултатът.\"></textarea></label>",
      "css": ".ds-field-label{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);display:grid;gap:8px;font-size:12px;font-weight:650;color:#20242c}.ds-task-field{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);display:block;width:100%;border:1px solid #aeb1ba;background:#fff;color:#20242c;border-radius:3px;font-size:13px;font-weight:450;line-height:1.7;padding:12px 13px;resize:vertical;caret-color:#f2796c}.ds-task-field::placeholder{color:#62656e;opacity:1}.ds-task-field:focus-visible{outline:3px solid #7aa9e8;outline-offset:4px;}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Persistent location on graphite; paper identifies the selected destination.",
      "html": "<nav class=\"ds-sidebar-nav\" aria-label=\"Основна навигация\"><a class=\"ds-nav-active\" href=\"#home\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"19\" height=\"19\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10H3Z\"/><path d=\"M9 20v-7h6v7\"/></svg><span>Начало</span></a><a class=\"ds-nav-item\" href=\"#tasks\"><svg viewBox=\"0 0 24 24\" width=\"19\" height=\"19\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10H3Z\"/><path d=\"M9 20v-7h6v7\"/></svg><span>Задачи</span></a></nav>",
      "css": ".ds-sidebar-nav{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);width:184px;padding:15px;background:#111315;display:grid;gap:3px}.ds-nav-active,.ds-nav-item{display:flex;align-items:center;gap:13px;min-height:46px;padding:12px 13px;border:0;border-radius:9px;font-size:13px;text-decoration:none}.ds-nav-item{color:#b9bdc7;background:none}.ds-nav-active{background:#f3f4f6;color:#1a1d24}.ds-nav-active svg{color:#cf352c}.ds-nav-item:hover{background:#25282e;color:#fff}.ds-nav-active:hover{background:#fff;color:#14161b}.ds-nav-active:focus-visible,.ds-nav-item:focus-visible{outline:3px solid #7aa9e8;outline-offset:4px;}@media(prefers-reduced-motion:no-preference){.ds-nav-active,.ds-nav-item{transition:background-color 160ms ease,color 160ms ease}}"
    },
    {
      "name": "Category Tag",
      "kind": "chip",
      "description": "A factual category label on featured paper content.",
      "html": "<span class=\"ds-category-tag\">Въпрос</span>",
      "css": ".ds-category-tag{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);display:inline-flex;align-items:center;min-height:26px;border:1px solid #a9b5c7;border-radius:20px;padding:3px 10px;font-size:11px;color:#536177;background:#f3f4f6}"
    },
    {
      "name": "Work Surface",
      "kind": "card",
      "refersTo": "work-surface",
      "description": "The flat cool-paper container for a task, draft or inspectable result.",
      "html": "<section class=\"ds-work-surface\"><h2>Текуща задача</h2><p>Опиши целта, прегледай черновата и запази полезния резултат.</p></section>",
      "css": ".ds-work-surface{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);padding:31px 34px 24px;border-radius:14px;background:#f3f4f6;color:#20242c;box-shadow:none}.ds-work-surface h2{font-size:clamp(23px,2.1vw,30px);line-height:1.2;letter-spacing:-.025em;font-weight:730;margin:0 0 14px}.ds-work-surface p{font-size:12px;line-height:1.7;color:#4c4e55;max-width:48ch;margin:0 0 24px}@media(max-width:760px){.ds-work-surface{padding:24px 22px;border-radius:12px}}"
    },
    {
      "name": "Goal Destination",
      "kind": "custom",
      "description": "One direct home action, with its purpose and a directional cue.",
      "html": "<button class=\"ds-goal\" type=\"button\"><span class=\"ds-goal-copy\"><strong>Създай съдържание</strong><span>От ясна идея до полезна чернова.</span></span><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></button>",
      "css": ".ds-goal{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);display:flex;align-items:center;justify-content:space-between;width:100%;gap:24px;padding:25px 0;text-align:left;background:none;color:#15171b;border:0;border-top:1px solid #dadddf;border-bottom:1px solid #dadddf;border-radius:0;min-height:104px;cursor:pointer}.ds-goal-copy{display:block;min-width:0}.ds-goal-copy>strong{display:block;font-size:clamp(23px,2.2vw,30px);font-weight:650;line-height:1.2;letter-spacing:-.025em}.ds-goal-copy>span{display:block;font-size:14px;line-height:1.5;margin-top:8px;color:#61646d}.ds-goal>svg{flex-shrink:0;color:#737780}.ds-goal:hover>svg{transform:translate(3px,-3px)}.ds-goal[data-preview=true]>svg,.ds-goal[data-preview=true] strong{color:#cf352c}.ds-goal:focus-visible{outline:3px solid #2c68b0;outline-offset:5px}@media(prefers-reduced-motion:no-preference){.ds-goal>svg{transition:color 180ms ease,transform 220ms cubic-bezier(.16,1,.3,1)}}@media(max-width:760px){.ds-goal{gap:12px;padding:24px 0}.ds-goal-copy>strong{font-size:26px}.ds-goal-copy>span{font-size:13px;max-width:31ch}}"
    },
    {
      "name": "More Disclosure",
      "kind": "custom",
      "description": "Native progressive disclosure for secondary workflow destinations.",
      "html": "<details class=\"ds-more\"><summary>Още <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></summary><div><button type=\"button\">3D карта</button><button type=\"button\">Специалисти</button></div></details>",
      "css": ".ds-more{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);position:relative;width:230px;color:#c0c7d4}.ds-more>summary{display:flex;align-items:center;justify-content:space-between;gap:10px;list-style:none;cursor:pointer;min-height:44px;padding:10px 13px;font-size:12px;border-radius:8px;background:#111315}.ds-more>summary::-webkit-details-marker{display:none}.ds-more[open]>div{position:relative;margin-top:8px;width:230px;padding:8px;background:#f6f5f1;color:#131518;border-radius:14px;box-shadow:0 18px 50px #0006;display:grid}.ds-more button{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);min-height:48px;display:flex;align-items:center;justify-content:space-between;padding:12px 14px;text-align:left;border:0;background:transparent;color:inherit;border-radius:8px;font-size:13px;cursor:pointer}.ds-more button:hover{background:#e3e4df}.ds-more>summary:focus-visible,.ds-more button:focus-visible{outline:3px solid #7aa9e8;outline-offset:4px;}@media(prefers-reduced-motion:no-preference){.ds-more[open]>div{animation:ds-more-arrival 160ms cubic-bezier(.16,1,.3,1) both}@keyframes ds-more-arrival{from{opacity:0;transform:translateY(-5px);filter:blur(3px)}to{opacity:1;transform:translateY(0);filter:blur(0)}}}"
    },
    {
      "name": "Task Navigation",
      "kind": "nav",
      "description": "Clear workflow destinations, separate from optional exploration.",
      "html": "<nav class=\"ds-task-nav\" aria-label=\"Работна област\"><button type=\"button\" aria-pressed=\"true\">Задачи</button><button type=\"button\" aria-pressed=\"false\">Реклами</button><button type=\"button\" aria-pressed=\"false\">Видео</button><button type=\"button\" aria-pressed=\"false\">Екип</button></nav>",

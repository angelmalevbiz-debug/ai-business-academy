      "html": "<button class=\"ds-button-secondary\" type=\"button\">Назад</button>",
      "css": ".ds-button-secondary{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);min-height:46px;padding:12px 17px;border:1px solid #525865;border-radius:9px;background:#252931;color:#f0f2f6;font-size:13px;cursor:pointer;box-shadow:none}.ds-button-secondary:hover{background:#252931;color:#f0f2f6}.ds-button-secondary:focus-visible{outline:3px solid #7aa9e8;outline-offset:4px;}.ds-button-secondary:disabled{opacity:.5;cursor:wait}@media(prefers-reduced-motion:no-preference){.ds-button-secondary{transition:background-color 160ms ease,color 160ms ease,transform 120ms ease-out}}@media(prefers-reduced-motion:no-preference){.ds-button-secondary:active:not(:disabled){transform:scale(.975)}}"
    },
    {
      "name": "Task Field",
      "kind": "input",
      "refersTo": "task-field",
      "description": "A labeled writable field on the current task's paper.",
      "html": "<label class=\"ds-field-label\">Какво искаш да създадеш?<textarea class=\"ds-task-field\" rows=\"3\" placeholder=\"Опиши целта и за кого е резултатът.\"></textarea></label>",
      "css": ".ds-field-label{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);display:grid;gap:8px;font-size:12px;font-weight:650;color:#20242c}.ds-task-field{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);display:block;width:100%;border:1px solid #aeb1ba;background:#fff;color:#20242c;border-radius:3px;font-size:13px;font-weight:450;line-height:1.7;padding:12px 13px;resize:vertical;caret-color:#f2796c}.ds-task-field::placeholder{color:#62656e;opacity:1}.ds-task-field:focus-visible{outline:3px solid #7aa9e8;outline-offset:4px;}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Persistent location on graphite; paper identifies the selected destination.",
      "html": "<nav class=\"ds-sidebar-nav\" aria-label=\"Основна навигация\"><a class=\"ds-nav-active\" href=\"#home\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"19\" height=\"19\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10H3Z\"/><path d=\"M9 20v-7h6v7\"/></svg><span>Начало</span></a><a class=\"ds-nav-item\" href=\"#tasks\"><svg viewBox=\"0 0 24 24\" width=\"19\" height=\"19\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10H3Z\"/><path d=\"M9 20v-7h6v7\"/></svg><span>Задачи</span></a></nav>",
      "css": ".ds-sidebar-nav{font-family:var(--font-sans,\"Manrope Variable\",Manrope,sans-serif);width:184px;padding:15px;background:#111315;display:grid;gap:3px}.ds-nav-active,.ds-nav-item{display:flex;align-items:center;gap:13px;min-height:46px;padding:12px 13px;border:0;border-radius:9px;font-size:13px;text-decoration:none}.ds-nav-item{color:#b9bdc7;background:none}.ds-nav-active{background:#f3f4f6;color:#1a1d24}.ds-nav-active svg{color:#cf352c}.ds-nav-item:hover{background:#25282e;color:#fff}.ds-nav-active:hover{background:#fff;color:#14161b}.ds-nav-active:focus-visible,.ds-nav-item:focus-visible{outline:3px solid #7aa9e8;outline-offset:4px;}@media(prefers-reduced-motion:no-preference){.ds-nav-active,.ds-nav-item{transition:background-color 160ms ease,color 160ms ease}}"
    },
